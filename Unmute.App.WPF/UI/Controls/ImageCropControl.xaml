<UserControl x:Class="Unmute.App.WPF.UI.Controls.ImageCropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Unmute.App.WPF.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid DockPanel.Dock="Top" Margin="8">
        <Image x:Name="PreviewControl" Stretch="Uniform" Source="{Binding PreviewImage}" LayoutUpdated="OnPreviewChanged"/>
        
        <Canvas x:Name="CropControl" Background="Transparent">
            <Grid x:Name="SelectionRect"
                  Width="0"
                  Height="0"
                  MouseLeftButtonDown="SelectionRect_MouseLeftButtonDown"
                  MouseLeftButtonUp="SelectionRect_MouseLeftButtonUp"
                  MouseMove="SelectionRect_MouseMove">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Rectangle
                   Grid.Column="1"
                   Grid.Row="1"
                   Stroke="Red"
                   StrokeThickness="2"
                   Fill="#30FF0000"/>

                <Thumb x:Name="ThumbNW"
                    Grid.Column="0"
                    Grid.Row="0"
                    Width="10"
                    Height="10"
                    Cursor="SizeNWSE"/>

                <Thumb x:Name="ThumbSE"
                    Grid.Column="2"
                    Grid.Row="2"
                    Width="10"
                    Height="10"
                    Cursor="SizeNWSE"/>

                <Thumb x:Name="ThumbNE"
                    Grid.Column="2"
                    Grid.Row="0"
                    Width="10"
                    Height="10"
                    Cursor="SizeNESW"/>

                <Thumb x:Name="ThumbSW"
                    Grid.Column="0"
                    Grid.Row="2"
                    Width="10"
                    Height="10"
                    Cursor="SizeNESW"/>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
